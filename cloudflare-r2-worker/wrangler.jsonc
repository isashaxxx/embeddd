{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "embeddd-media",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "embeddd"
    }
  ]
}
